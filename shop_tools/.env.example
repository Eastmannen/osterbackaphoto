# Kopiera till shop_tools/.env och fyll i. Filen .env checkas ALDRIG in (skyddas av .gitignore).
# Klistra aldrig in nycklarna i en chatt.

# --- TESTMILJÖ (standard) ---
# R2: https://<ditt Cloudflare Account ID>.r2.cloudflarestorage.com
SHOP_TEST_R2_ENDPOINT=
# Nyckeln "shop-test-uploader": Object Read & Write, endast shop-previews-test och shop-originals-test
SHOP_TEST_R2_ACCESS_KEY_ID=
SHOP_TEST_R2_SECRET_ACCESS_KEY=
SHOP_TEST_PREVIEW_BUCKET=shop-previews-test
SHOP_TEST_ORIGINAL_BUCKET=shop-originals-test
SHOP_TEST_PREVIEW_PUBLIC_URL=
# Supabase "Session pooler" (Connect -> Session pooler) med rollen shop_admin, t.ex.
# postgresql://shop_admin.<projekt-id>:<lösenord>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres
SHOP_TEST_DB_URL=

# --- PRODUKTION (fylls i först vid lansering) ---
SHOP_PROD_R2_ENDPOINT=
SHOP_PROD_R2_ACCESS_KEY_ID=
SHOP_PROD_R2_SECRET_ACCESS_KEY=
SHOP_PROD_PREVIEW_BUCKET=
SHOP_PROD_ORIGINAL_BUCKET=
SHOP_PROD_PREVIEW_PUBLIC_URL=
SHOP_PROD_DB_URL=

# --- Valfritt ---
# SHOP_SIGNATURE_TEXT=@osterbackaphoto.com
# SHOP_SIGNATURE_PATH=/sökväg/till/signatur.png   (standard: shop_tools/assets/signatur.png)
# SHOP_WATERMARK_TEXT=osterbackaphoto.com
